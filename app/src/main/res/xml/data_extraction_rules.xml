<?xml version="1.0" encoding="utf-8"?>
<!-- Back up only the Room DB and DataStore (PLAN.md §9 "Bonus"). Only included paths are copied, so
     downloaded audio (getExternalFilesDir, "external" domain, Podcasts/ via DownloadPaths) is left
     out of both cloud backup and device transfer (Smart Switch). An explicit exclude for it would
     fail lint, since it isn't inside an included path. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
